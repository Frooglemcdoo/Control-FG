@echo off
setlocal
cd /d "%~dp0"
if not exist "Control_DX12.exe" (
  echo Place this file beside Control_DX12.exe and exit any running Control session first.
  pause
  exit /b 1
)
set "CONTROLFG_NATIVE_CPU_TIMING=1"
set "CONTROLFG_CPU_PREPARATION_PHASES=0"
set "CONTROLFG_STREAMING_BUDGET_MS=8"
set "CONTROLFG_STREAMING_SLICES=16"
set "CONTROLFG_STREAMING_PIN_SLICES=1"
set "CONTROLFG_DIRECTSTORAGE=0"
set "CONTROLFG_NATIVE_GPU_STORAGE=1"
set "CONTROLFG_EARLY_STORAGE=0"
set "CONTROLFG_CPU_WORKLOAD=1"
set "CONTROLFG_LOADER_TRACE=0"
set "CONTROLFG_COMPLETION_TRACE=0"
set "CONTROLFG_TEXTURE_CONTRACT=0"
set "CONTROLFG_CPU_MATERIAL_RESOLVER=0"
set "CONTROLFG_CPU_DIRTY_WRITERS=0"
set "CONTROLFG_CPU_MATERIAL_DIFF=0"
set "CONTROLFG_CPU_APPEND_HOOKS=0"
set "CONTROLFG_RT_APPEND_FAST=0"
set "CONTROLFG_RT_POINTER_FAST=0"
start "" /wait "%~dp0Control_DX12.exe"
endlocal
